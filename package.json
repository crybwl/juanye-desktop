{
  "name": "juanye-desktop",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "version": "0.3.4",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "卷页 — 本地题目编辑、公式排版与 PDF 组卷",
  "author": "Juanye",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crybwl/juanye-desktop.git"
  },
  "homepage": "https://github.com/crybwl/juanye-desktop#readme",
  "bugs": {
    "url": "https://github.com/crybwl/juanye-desktop/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-icons.cjs && node scripts/copy-pdf-assets.cjs && tsc -b && vite build",
    "preview": "vite preview",
    "start": "node scripts/start.cjs",
    "test": "tsx --test src/*.test.ts tests/*.test.ts && node --test electron/*.test.cjs",
    "test:ui": "node scripts/sidebar-regression.cjs --no-screenshots",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win zip nsis"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@xmldom/xmldom": "0.9.12",
    "katex": "^0.19.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.13.0",
    "markdown-it": "15.0.3",
    "motion": "^12.43.0",
    "node-tikzjax": "1.0.5",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@napi-rs/canvas": "1.0.13",
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jszip": "3.10.2",
    "playwright": "1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.sanx.juanye.desktop",
    "productName": "卷页",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "Juanye-${version}-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Juanye-${version}-Setup.${ext}"
    }
  }
}
